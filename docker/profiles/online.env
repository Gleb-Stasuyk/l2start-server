# Profile "online": VPS. Put secrets (L2S_DB_PASSWORD) and L2S_PUBLIC_HOST into docker/.env (not in git).
L2S_PROFILE=online
L2S_BIND=0.0.0.0
L2S_PUBLIC_HOST=CHANGE_ME_VPS_IP
L2S_RESTART=unless-stopped
L2S_DB_NAME=l2start
L2S_GAME_XMS=2g
L2S_GAME_XMX=4g
L2S_LOGIN_XMS=128m
L2S_LOGIN_XMX=256m
L2S_GEODATA_DIR=./geodata.empty
