# Profile "solo": single player on this PC (client and server on 127.0.0.1).
L2S_PROFILE=solo
L2S_BIND=127.0.0.1
L2S_PUBLIC_HOST=127.0.0.1
L2S_RESTART=no
L2S_DB_NAME=l2start
# Local-only database (no host port). For "online" set a strong password in docker/.env instead.
L2S_DB_PASSWORD=l2start_local
# Docker Desktop has 6 GB RAM (C:\Users\user\.wslconfig): 3g game heap = geodata (~0.6-0.9 GB) + bots + players.
L2S_GAME_XMS=512m
L2S_GAME_XMX=3584m
# Game container RAM cap (mem_limit); the WSL VM (.wslconfig memory) must be at least this.
L2S_GAME_MEM=5g
L2S_LOGIN_XMS=128m
L2S_LOGIN_XMX=256m
# Folder with geodata (*.l2j). Empty = run without geodata. On Gleb's PC docker/.env sets
# L2S_GEODATA_DIR=F:/l2start-data/geodata (see docs/GEODATA.md).
L2S_GEODATA_DIR=./geodata.empty
