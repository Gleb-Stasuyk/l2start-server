# Profile "solo": single player on this PC (client and server on 127.0.0.1).
L2S_PROFILE=solo
L2S_BIND=127.0.0.1
L2S_PUBLIC_HOST=127.0.0.1
L2S_RESTART=no
L2S_DB_NAME=l2start
# Local-only database (no host port). For "online" set a strong password in docker/.env instead.
L2S_DB_PASSWORD=l2start_local
# Docker Desktop currently has ~3.8 GB RAM: keep the game heap at 2g.
L2S_GAME_XMS=512m
L2S_GAME_XMX=2g
L2S_LOGIN_XMS=128m
L2S_LOGIN_XMX=256m
# Folder with geodata (*.l2j). Empty = run without geodata (as the current servers do).
L2S_GEODATA_DIR=./geodata.empty
