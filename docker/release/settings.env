# L2Start local server settings (L2Launcher writes this file). Applied on server restart.
# Auto class change dialog at 20/40/76 (stock ClassMaster popup, free): off or any of 1,2,3
L2S_CLASS_MASTER=1,2,3
# Must stay off. Module stock-npcs spawns Scheme Buffer 50008 (and GM Shop 50010).
# on would write a second 50008 spawn into the container on startup.
L2S_STOCK_NPC_BUFFER=off
# Duration of buffs from the stock buffers in seconds (community board + scheme buffer); 0 = stock
L2S_BUFF_DURATION=3600
# Enchant: max +N for every scroll and chance % above the safe level (stock 16 / 66)
L2S_ENCHANT_MAX=16
L2S_ENCHANT_CHANCE=66
