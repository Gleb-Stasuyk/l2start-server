# Copy to docker/modules.env (not in git) to switch modules / change settings without editing files.
# Applies to login, db-init and game containers; read on container start (start.bat).
#
# Switch a module on/off (overrides modules.ini):  L2_MODULE_<ID>=on|off   (<ID>: upper case, '-' -> '_')
#L2_MODULE_HELLO=on
#
# Module setting (overrides config/modules/<id>.ini):  L2_MOD_<ID>__<KEY>=value
#L2_MOD_HELLO__MAXHELLOPERDAY=10
#
# Platform setting (overrides platform.ini):  L2_PLATFORM__<KEY>=value
#L2_PLATFORM__DISABLEALL=true
#L2_PLATFORM__FAILUREPOLICY=continue
